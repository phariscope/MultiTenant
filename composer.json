{
    "name": "phariscope/multitenant",
    "version": "0.0.27",
    "type": "symfony-bundle",
    "description": "Multitenant components.",
    "keywords": ["tenant", "multitenant", "multi-tenant"],
    "homepage": "https://github.com/phariscope/MultiTenant",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Frédéric Royet",
            "homepage": "https://www.linkedin.com/in/frederic-royet-42568566/",
            "role": "Project Founder"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "symfony/orm-pack": "^2.4 || ^5.4 || ^6.0 || ^7.0 || ^8.0",
        "phariscope/safephp": "^1.0",
        "symfony/process": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/dotenv": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/runtime": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "doctrine/dbal": "^4"
    },
    "suggest": {
        "ext-pdo_sqlite": "SQLite (tenant DB paths and tenants/tenants.sqlite shortname registry)."
    },
    "require-dev": {
        "infection/extension-installer": "^0.1.2",
        "infection/infection": "^0.35",
        "phpstan/phpdoc-parser": "^2.3",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0",
        "mockery/mockery": "^1.6",
        "mikey179/vfsstream": "^1.6"
    },
    "autoload": {
        "psr-4" : {
            "Phariscope\\MultiTenant\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4" : {
            "Phariscope\\MultiTenant\\Tests\\" : "tests/unit",
            "Phariscope\\MultiTenant\\Tests\\Integration\\" : "tests/integration"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.11"
        },
        "allow-plugins": {
            "infection/extension-installer": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "runtime": {
            "dotenv_path": "src/Symfony/.env"
        }
    }
}
